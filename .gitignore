# Dependencies and build output
node_modules/
dist/
.astro/

# Cloudflare local state (includes the local D1 database with test leads)
.wrangler/

# Secrets and local environment. .dev.vars.example / .env.example are templates and are committed.
.dev.vars*
!.dev.vars.example
.env
.env.*
!.env.example

# Raw stock media and 3D sources: large, and the stock licences do not allow redistributing the
# collection. Back this folder up separately; the build only needs public/ and src/data/.
assets/raw/

# Scratch scripts
scripts/_*_tmp.mjs

# Logs
*.log
npm-debug.log*

# Editors, tools, OS
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Collateral: raw stock downloads (same licence limits as assets/raw) and review renders
collateral/assets/raw/
collateral/review/
# Collateral outputs the scripts rebuild: flattened image pack (images/build/render.mjs), intermediate
# screen captures, and full-resolution print PDFs (node collateral/tools/build.mjs). Email PDFs are kept.
collateral/images/pack/
collateral/images/build/laptop/
collateral/images/build/narrow/
collateral/out/*-print.pdf
# Internal prospect research (third-party details, not for the repo)
collateral/trident/research-brief.md
collateral/trident/OUTLINE.md
