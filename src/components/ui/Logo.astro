---
interface Props { size?: number; withText?: boolean }
const { size = 26, withText = true } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path class="frame" d="M3 10V5a2 2 0 0 1 2-2h5M22 3h5a2 2 0 0 1 2 2v5M29 22v5a2 2 0 0 1-2 2h-5M10 29H5a2 2 0 0 1-2-2v-5" stroke-width="2.2" stroke-linecap="round"/>
    <path class="eye" d="M7 16s3.6-6 9-6 9 6 9 6-3.6 6-9 6-9-6-9-6Z" stroke-width="1.8"/>
    <circle class="pupil" cx="16" cy="16" r="2.8"/>
  </svg>
  {withText && <span class="logo-text"><span>infra</span><b>glance</b></span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 9px; }
  /* Colours follow the tone tokens, so the mark reads on dark and light headers alike */
  .frame { stroke: var(--cyan); }
  .eye { stroke: var(--text); }
  .pupil { fill: var(--cyan); }
  .logo-text { font-family: var(--font-display); font-size: 1.125rem; line-height: 1; letter-spacing: -0.01em; font-weight: 500; color: var(--text); }
  .logo-text b { font-weight: 600; color: var(--cyan); }
</style>
