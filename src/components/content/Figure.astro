---
import Picture from '../media/Picture.astro';
interface Props { img: string; alt: string; caption?: string; wide?: boolean }
const { img, alt, caption, wide = false } = Astro.props;
---
<figure class={`fig ${wide ? 'fig--wide' : ''}`}>
  <Picture img={img} alt={alt} sizes={wide ? '(min-width: 1100px) 920px, 100vw' : '(min-width: 760px) 680px, 100vw'} class="fig-img pic--framed" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 2em 0; }
  .fig :global(.fig-img) { aspect-ratio: 16 / 9; }
  .fig--wide { margin-inline: calc(-1 * min(6vw, 120px)); }
  figcaption { margin-top: 10px; padding-left: 10px; border-left: 2px solid var(--cyan); font-size: var(--fs-sm); line-height: 1.5; color: var(--muted); }
  @media (max-width: 1100px) { .fig--wide { margin-inline: 0; } }
</style>
