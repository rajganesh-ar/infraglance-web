---
/**
 * Lazy three.js island. Shows a light CSS poster until the scene scrolls near
 * the viewport, then mounts it during idle time. Reduced motion, Save-Data,
 * ?nowebgl, no WebGL2 or a failed mount keep the poster (`.is-static`, plus a
 * `scene:static` event). Events on the element: scene:ready (detail = SceneApi),
 * scene:static, scene:lost, scene:restored; internally scene:stage (a stage was
 * created, so a failed mount can be torn down) and scene:error (a frame threw).
 * Mounts never overlap: a context restored mid-mount retires that mount first.
 * Page chrome laid over the canvas (.scene-head, .net-head, [data-scene-overlay])
 * is measured by the stage; scenes frame their subject and labels below it.
 *
 * The canvas takes its background from the nearest painted ancestor, so the canvas
 * edge is invisible. The site puts scenes in navy bands (background: var(--navy))
 * and passes `dark`: the stage then runs its dark rig and the tags and HUD use their
 * dark styles. A light (.tone-mist) host still gets the daylight look.
 */
interface Props {
  name: string;
  caption: string;
  accent?: string;
  class?: string;
  eager?: boolean;
  /** Small honesty tag in the corner; false hides it (e.g. when the host shows its own). */
  note?: string | false;
  /** The host band is dark (navy): dark poster, and the 3D uses its dark rig (stage.ts reads the band colour). */
  dark?: boolean;
  /**
   * Camera HUD (corner brackets, camera name, clock), so the scene reads as one camera's view.
   * true = the scene's default camera name; a string names it; false/omitted = no HUD.
   */
  hud?: boolean | string;
}
/** Default camera names per scene, as a site's camera list would name them. */
const CAMS: Record<string, string> = {
  'guard-zone': 'CAM-07 · Press bay 2',
  'defect-part': 'CAM-12 · Inspection cell',
  'belt-flow': 'CAM-21 · CV-03 head end',
  'sense-scene': 'CAM-16 · Pipe rack B',
  'infra-bridge': 'UAV-02 · Bridge survey',
};
const { name, caption, accent = 'var(--cyan)', class: cls = '', eager = false, note = 'Illustrative scene · demo data', dark = false, hud = false } = Astro.props;
const cam = typeof hud === 'string' ? hud : hud ? CAMS[name] : undefined;
---
<div class={`scene ${dark ? 'scene--dark' : ''} ${cls}`} data-scene={name} data-eager={eager ? '' : undefined} style={`--accent:${accent}`}>
  <div class="scene-poster" aria-hidden="true">
    <div class="poster-floor"></div>
    <div class="poster-zone"></div>
    <div class="poster-shadow"></div>
  </div>
  {cam && (
    <div class="scene-hud" data-hud aria-hidden="true">
      <i class="hc tl"></i><i class="hc tr"></i><i class="hc bl"></i><i class="hc br"></i>
      <span class="hud-cam"><b class="rec"></b>{cam}</span>
      <span class="hud-time" data-hud-time>--:--:--</span>
    </div>
  )}
  {note && <span class="scene-note" aria-hidden="true">{note}</span>}
  <p class="sr-only">{caption}</p>
</div>

<style>
  .scene { position: relative; overflow: hidden; isolation: isolate; }
  .scene-poster { position: absolute; inset: 0; transition: opacity 0.9s var(--ease-out); pointer-events: none; }
  /* Light "yard floor" poster: hairline 6 m joints in perspective, fading into the section colour. */
  .poster-floor {
    position: absolute; inset: 18% -30% -10%; transform: perspective(700px) rotateX(62deg); transform-origin: 50% 100%;
    background-image:
      linear-gradient(to right, rgba(8, 17, 29, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(8, 17, 29, 0.07) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.6) 45%, transparent 85%);
  }
  .poster-zone {
    position: absolute; left: 50%; top: 62%; width: min(44%, 420px); aspect-ratio: 1.6; translate: -50% -50%;
    transform: perspective(700px) rotateX(62deg);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); border-radius: 2px;
  }
  .poster-shadow { position: absolute; left: 50%; top: 66%; width: 50%; height: 18%; translate: -50% -50%; background: radial-gradient(closest-side, rgba(8, 17, 29, 0.08), transparent); }
  .scene.is-live .scene-poster { opacity: 0; }
  /* The canvas background equals the section colour; feathering the top and bottom hides the fogged far floor's edge. */
  .scene :global(.scene-canvas) {
    position: absolute; inset: 0; width: 100% !important; height: 100% !important; opacity: 0; transition: opacity 0.9s var(--ease-out);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 var(--scene-fade-top, 14%), #000 calc(100% - var(--scene-fade-bottom, 6%)), transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 var(--scene-fade-top, 14%), #000 calc(100% - var(--scene-fade-bottom, 6%)), transparent 100%);
  }
  .scene.is-live :global(.scene-canvas) { opacity: 1; }
  .scene-note {
    position: absolute; right: 12px; top: 12px; z-index: 3; pointer-events: none;
    font: 500 var(--fs-micro, 0.6875rem) / 1 var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase;
    color: #3d4b5c; background: rgba(255, 255, 255, 0.86); border: 1px solid rgba(8, 17, 29, 0.1);
    border-radius: var(--radius, 2px); padding: 5px 7px;
  }

  /* Dark (navy) band: the poster is a dark yard floor. */
  .scene--dark .poster-floor {
    background-image:
      linear-gradient(to right, rgba(201, 214, 228, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(201, 214, 228, 0.07) 1px, transparent 1px);
  }
  .scene--dark .poster-shadow { background: radial-gradient(closest-side, rgba(0, 0, 0, 0.3), transparent); }
  .scene--dark .scene-note { color: #c3cdd8; background: rgba(8, 13, 20, 0.8); border-color: rgba(255, 255, 255, 0.12); }

  /*
   * 3D labels (created by src/three/core/labels.ts), styled as detection tags on a camera feed:
   * a solid status-coloured tag, white mono caps, a hairline leader to the anchor. `info` (context,
   * not a detection) is a dark glass tag with a cyan marker.
   */
  .scene :global(.scene-labels) { position: absolute; inset: 0; pointer-events: none; z-index: 2; overflow: hidden; }
  .scene :global(.scene-label) {
    --tone: #0e7490;
    position: absolute; left: 0; top: 0; display: inline-flex; align-items: center; gap: 6px;
    padding: 3px 7px; border-radius: 1px; white-space: nowrap;
    font: 600 10.5px/14px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase;
    color: #fff; background: var(--tone);
    border: 1px solid color-mix(in srgb, var(--tone) 70%, #000);
    box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.5);
    transition: opacity 0.25s;
  }
  .scene :global(.scene-label .dot) { display: none; }
  /* Leader to the anchor: straight down, angled when the chip sits beside the thing it names, or up from the
     chip's top edge when it hangs below it (labels.ts sets --lead-top: 0 and an angle near 180°). */
  .scene :global(.scene-label::after) {
    content: ''; position: absolute; left: var(--lead-x, 50%); top: var(--lead-top, 100%); width: 1px; height: var(--lead, 10px);
    background: var(--tone); transform: rotate(var(--lead-a, 0deg)); transform-origin: 50% 0;
  }
  .scene :global(.scene-label.tone-ok) { --tone: #15803d; }
  .scene :global(.scene-label.tone-warn) { --tone: #b45309; }
  .scene :global(.scene-label.tone-bad) { --tone: #d42a2a; }
  .scene :global(.scene-label.tone-info) {
    --tone: #22d3ee;
    color: #e6f1f8; background: rgba(9, 15, 24, 0.86); border-color: rgba(34, 211, 238, 0.42);
    font-weight: 500; text-transform: none; letter-spacing: 0.01em;
  }
  .scene :global(.scene-label.tone-info .dot) { display: block; flex: none; width: 5px; height: 5px; background: var(--tone); }
  .scene :global(.scene-label.tone-info::after) { background: rgba(34, 211, 238, 0.6); }
  /* Light (mist) bands: the info tag is a white chip. */
  .scene:not(.scene--dark) :global(.scene-label.tone-info) { --tone: #0e7490; color: #0b1220; background: rgba(255, 255, 255, 0.96); border-color: rgba(8, 17, 29, 0.16); }
  .scene:not(.scene--dark) :global(.scene-label.tone-info::after) { background: rgba(8, 17, 29, 0.38); }
  @media (max-width: 640px) {
    .scene :global(.scene-label) { padding: 2px 5px; gap: 5px; font-size: 10px; }
    .scene-note { top: 8px; right: 8px; }
  }

  /* Camera HUD: corner brackets, camera name with a recording dot, and a clock, in the canvas margins. */
  .scene-hud { position: absolute; inset: 0; z-index: 2; pointer-events: none; --hud: rgba(226, 234, 242, 0.78); --hud-line: rgba(226, 234, 242, 0.42); }
  /* No camera view without the 3D: the static poster shows no HUD. */
  .scene.is-static .scene-hud { display: none; }
  .scene:not(.scene--dark) .scene-hud { --hud: rgba(11, 18, 32, 0.72); --hud-line: rgba(11, 18, 32, 0.32); }
  .scene-hud .hc { position: absolute; width: 18px; height: 18px; border: 0 solid var(--hud-line); }
  .scene-hud .tl { left: 14px; top: 14px; border-width: 1px 0 0 1px; }
  .scene-hud .tr { right: 14px; top: 14px; border-width: 1px 1px 0 0; }
  .scene-hud .bl { left: 14px; bottom: 14px; border-width: 0 0 1px 1px; }
  .scene-hud .br { right: 14px; bottom: 14px; border-width: 0 1px 1px 0; }
  .hud-cam, .hud-time {
    position: absolute; bottom: 20px; display: inline-flex; align-items: center; gap: 8px;
    font: 500 11px/1 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--hud);
    font-variant-numeric: tabular-nums;
  }
  .hud-cam { left: 40px; }
  .hud-time { right: 40px; }
  .rec { width: 6px; height: 6px; border-radius: 50%; background: #ef4444; animation: rec 2s steps(1, end) infinite; }
  @keyframes rec { 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) { .rec { animation: none; } }
  @media (max-width: 640px) {
    .scene-hud .hc { width: 12px; height: 12px; }
    .scene-hud .tl, .scene-hud .bl { left: 8px; }
    .scene-hud .tr, .scene-hud .br { right: 8px; }
    .scene-hud .tl, .scene-hud .tr { top: 8px; }
    .scene-hud .bl, .scene-hud .br { bottom: 8px; }
    .hud-cam, .hud-time { bottom: 13px; font-size: 10px; }
    .hud-cam { left: 26px; }
    .hud-time { right: 26px; }
  }
</style>

<script>
  import { peopleScenes, preloadPeople, scenes, webglAvailable, type SceneApi } from '../three/registry';
  import { prefersReducedMotion } from '../lib/motion';

  type SceneEl = HTMLElement & { sceneApi?: SceneApi };
  const params = new URLSearchParams(location.search);
  const saveData = !!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const disabled = prefersReducedMotion() || params.has('nowebgl') || saveData;
  const idle = (fn: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 60);

  // Camera HUD clocks: one shared 1 s tick, local time as an NVR overlay prints it.
  const clocks = [...document.querySelectorAll<HTMLElement>('[data-hud-time]')];
  if (clocks.length) {
    const p2 = (n: number) => String(n).padStart(2, '0');
    const tickClock = () => {
      if (document.hidden) return;
      const d = new Date();
      const s = `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())} ${p2(d.getHours())}:${p2(d.getMinutes())}:${p2(d.getSeconds())}`;
      clocks.forEach((c) => (c.textContent = s));
    };
    tickClock();
    setInterval(tickClock, 1000);
  }

  const markStatic = (el: SceneEl) => {
    el.classList.remove('is-live');
    el.classList.add('is-static');
    el.dispatchEvent(new CustomEvent('scene:static'));
  };

  document.querySelectorAll<SceneEl>('[data-scene]').forEach((el) => {
    const name = el.dataset.scene!;
    const load = scenes[name];
    if (disabled || !load) return markStatic(el);
    let started = false;
    let losses = 0;
    /** Bumped to retire a mount in flight; a retired mount destroys what it built. */
    let gen = 0;
    /** The mount in flight, if any: mounts never overlap (one build, one GL context at a time). */
    let pending: Promise<void> | null = null;
    /** Stages created by the mount in flight (createStage announces itself with scene:stage). */
    let building: Set<{ destroy(): void }> | null = null;
    el.addEventListener('scene:stage', (e) => building?.add((e as CustomEvent).detail));

    const teardown = (stages: Set<{ destroy(): void }>) => {
      stages.forEach((s) => {
        try {
          s.destroy();
        } catch {
          /* already gone */
        }
      });
      stages.clear();
      el.querySelectorAll('.scene-canvas, .scene-labels').forEach((n) => n.remove());
    };
    const fail = (err: unknown, what = 'failed to start') => {
      console.warn(`[scene] ${what}`, name, err);
      try {
        el.sceneApi?.destroy();
      } catch {
        /* ignore */
      }
      el.sceneApi = undefined;
      el.querySelectorAll('.scene-canvas, .scene-labels').forEach((n) => n.remove());
      markStatic(el);
    };

    const run = async () => {
      const my = ++gen;
      const mine = (building = new Set());
      try {
        const mod = await load();
        const api = await mod.mount(el);
        building = null;
        if (my !== gen || el.classList.contains('is-static')) {
          api.destroy(); // retired by a context restore (or the element went static) while it was building
          mine.clear();
          return;
        }
        mine.clear(); // the api owns its stage from here
        el.sceneApi = api;
        requestAnimationFrame(() => el.classList.add('is-live'));
        el.dispatchEvent(new CustomEvent('scene:ready', { detail: api }));
      } catch (err) {
        building = null;
        teardown(mine); // stop the render loop, observers and context of a half-built stage
        if (my === gen) fail(err);
      }
    };
    const mount = () => (pending = run().finally(() => (pending = null)));

    const start = async () => {
      if (started || el.sceneApi) return;
      started = true;
      io.disconnect();
      if (!webglAvailable()) return markStatic(el);
      // Scenes with people: fetch the avatars while the scene builds (cast.load() reuses the same promise).
      if (peopleScenes.has(name)) preloadPeople();
      await mount();
    };

    // Context loss: the stage pauses and drops .is-live (poster shows); remount on restore, at most twice.
    el.addEventListener('scene:restored', async () => {
      if (el.classList.contains('is-static')) return;
      if (pending) {
        gen++; // retire the mount in flight; it settles soon after the restore and destroys itself
        await pending;
      }
      if (pending) return; // another restore already started the fresh mount
      el.sceneApi?.destroy();
      el.sceneApi = undefined;
      if (++losses > 2) {
        el.querySelectorAll('.scene-canvas, .scene-labels').forEach((n) => n.remove());
        return markStatic(el);
      }
      await mount();
    });
    // A frame that throws: the stage has stopped itself; fall back to the poster.
    el.addEventListener('scene:error', () => {
      gen++;
      fail('a frame threw (see above)', 'stopped');
    });

    const io = new IntersectionObserver((es) => es.some((e) => e.isIntersecting) && idle(start), { rootMargin: '50% 0px' });
    if ('eager' in el.dataset) idle(start);
    else io.observe(el);
  });
</script>
