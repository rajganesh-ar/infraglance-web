---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <section class="nf tone-dark">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="container inner">
      <div class="frame vf" aria-hidden="true"><span class="mono">NO SIGNAL · 404</span></div>
      <span class="eyebrow">Error 404</span>
      <h1>This camera has nothing in view.</h1>
      <p class="lead">The page you’re looking for has moved or never existed.</p>
      <div class="btn-row"><a href="/" class="btn btn--primary">Back to home</a><a href="/products" class="btn btn--ghost">Browse products</a><a href="/contact" class="btn btn--ghost">Contact us</a></div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { position: relative; min-height: 100svh; display: grid; place-items: center; padding: calc(var(--header-h) + var(--s-12)) 0 var(--s-20); }
  .bg-grid { position: absolute; inset: 0; }
  .inner { position: relative; display: grid; gap: var(--s-4); justify-items: center; text-align: center; }
  .frame { width: min(320px, 80vw); aspect-ratio: 16 / 9; margin-bottom: var(--s-4); display: grid; place-items: center; border: 1px solid var(--line-2); border-radius: var(--radius-lg); background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.02) 0 2px, transparent 2px 4px), var(--surface); }
  .frame span { font-size: var(--fs-xs); color: var(--red); letter-spacing: 0.12em; }
  h1 { font-size: var(--fs-h1); max-width: 20ch; }
  .btn-row { justify-content: center; margin-top: var(--s-2); }
</style>
