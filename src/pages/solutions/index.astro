---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import PillarGrid from '../../components/sections/PillarGrid.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { nb } from '../../data/helpers';
---
<BaseLayout title="Solutions" description="Glance Guard, Inspect, Flow, Sense and Infra: five pillars for safety, quality, conveyors, plant condition and infrastructure assets on one platform.">
  <PageHero eyebrow="Solutions" title="Five pillars on <span class='gradient-text'>one platform.</span>" lead={nb("Safety, quality, conveyors and line flow, plant condition and infrastructure assets — sharing the same cameras, edge boxes, Hub and team.")} image="factory-hall-wide" crumbs={[{ href: '/solutions', label: 'Solutions' }]} />
  <section class="section section--tight tone-light">
    <div class="container container--wide"><PillarGrid /></div>
  </section>
  <CTASection image="cement-plant" title="Not sure where to start?" lead="Most sites begin with one pillar on one line or zone. We’ll help you pick the problem with the clearest return." />
</BaseLayout>
